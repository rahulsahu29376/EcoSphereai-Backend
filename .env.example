PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Deployed Service URLs
BACKEND_URL=https://ecosphereai-backend-3.onrender.com
CLIENT_URL=https://eco-sphereai-frontend.vercel.app

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Optional AI API keys (Google Gemini or OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
